{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokenledger/report",
  "title": "tokenledger report --json output",
  "type": "object",
  "properties": {
    "n_requests": {
      "type": "integer",
      "minimum": 0
    },
    "n_turns": {
      "type": "integer",
      "minimum": 0
    },
    "steps_per_turn": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "total_input": {
      "type": "integer",
      "minimum": 0
    },
    "total_output": {
      "type": "integer",
      "minimum": 0
    },
    "total_cache_read": {
      "type": "integer",
      "minimum": 0
    },
    "cache_read_pct": {
      "type": "number",
      "minimum": 0
    },
    "priming_total": {
      "type": "integer",
      "minimum": 0
    },
    "priming_pct": {
      "type": "number",
      "minimum": 0
    },
    "conversation_total": {
      "type": "integer",
      "minimum": 0
    },
    "conversation_pct": {
      "type": "number",
      "minimum": 0
    },
    "mean_prefix": {
      "type": "number",
      "minimum": 0
    },
    "max_prefix": {
      "type": "integer",
      "minimum": 0
    },
    "prefix_reread_cost": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "n_requests",
    "n_turns",
    "steps_per_turn",
    "total_input",
    "total_output",
    "total_cache_read",
    "cache_read_pct",
    "priming_total",
    "priming_pct",
    "conversation_total",
    "conversation_pct",
    "mean_prefix",
    "max_prefix",
    "prefix_reread_cost"
  ],
  "additionalProperties": false
}
