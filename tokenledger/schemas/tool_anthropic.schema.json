{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokenledger/tool_anthropic",
  "title": "Anthropic tool-use definition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type"
      ]
    }
  },
  "required": [
    "name",
    "description",
    "input_schema"
  ],
  "additionalProperties": false
}
