{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokenledger/error",
  "title": "tokenledger error",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^TL_E_[A-Z_]+$",
          "description": "TL_E_FILE_NOT_FOUND, TL_E_BAD_JSON, TL_E_BAD_ENCODING, TL_E_MISSING_FIELD, TL_E_BAD_VALUE, TL_E_NO_REQUESTS, TL_E_UNKNOWN_FORMAT, TL_E_STEP_NOT_FOUND, TL_E_USAGE, TL_E_INTERNAL, TL_E_OVERFLOW (JavaScript library API only)"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "hint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
